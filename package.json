{
  "name": "nus-companion",
  "version": "0.1.20",
  "description": "Nūs Companion: ask about your screen by voice or text. The Knot points, guides and can act.",
  "main": "src/main-companion.js",
  "private": true,
  "scripts": {
    "start": "electron src/main-companion.js",
    "smoke": "electron src/main-companion.js --smoke",
    "test": "node --test src/*.test.js companion/test/*.test.js",
    "setup:voice": "node scripts/setup-voice.js",
    "setup:embed": "node scripts/setup-embed.js",
    "start:companion": "electron src/main-companion.js",
    "smoke:companion": "electron src/main-companion.js --smoke",
    "dist:companion": "electron-builder --win --config electron-builder.companion.config.js --publish never",
    "dist:check:companion": "node scripts/package-security-check.js --profile=companion"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Pranav Desu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/potlakai/nus-companion.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.1",
    "onnxruntime-node": "1.29.0",
    "openai": "^7.5.0",
    "pdf-parse": "^1.1.1",
    "sherpa-onnx-node": "^1.13.8",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
